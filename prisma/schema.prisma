generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Symbol {
  id               String                  @id @default(cuid())
  symbolKey        String                  @unique
  displayName      String
  manufacturer     String?
  model            String?
  category         String
  categoryId       String?
  managedCategory  SymbolCategory?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status           String                  @default("draft")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  versions         SymbolVersion[]
  sourceAssets     SymbolSourceAsset[]
  validationIssues SymbolValidationIssue[]
  engineerNotes    SymbolEngineerNote[]
  documents        SymbolDocument[]
  bomTemplate      SymbolBomTemplate?

  @@index([status])
  @@index([category])
  @@index([categoryId])
}

model SymbolCategory {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  description    String?
  isProtected    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  symbols        Symbol[]

  @@index([name])
}

model WireCatalogEntry {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  wireType       String
  size           String
  color          String
  notes          String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
  @@index([isDefault])
}

model SymbolVersion {
  id                 String                  @id @default(cuid())
  symbolId           String
  symbol             Symbol                  @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  versionNumber      Int
  status             String                  @default("needs_review")
  svg                String
  metadataJson       String
  sourceInputSummary String?
  aiResponseId       String?
  createdAt          DateTime                @default(now())
  sourceAssets       SymbolSourceAsset[]
  validationIssues   SymbolValidationIssue[]
  engineerNotes      SymbolEngineerNote[]
  documents          SymbolDocument[]

  @@unique([symbolId, versionNumber])
  @@index([symbolId, status])
}

model SymbolValidationIssue {
  id        String         @id @default(cuid())
  symbolId  String
  versionId String?
  symbol    Symbol         @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  version   SymbolVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)
  severity  String
  code      String
  message   String
  path      String?
  createdAt DateTime       @default(now())

  @@index([symbolId])
  @@index([versionId])
  @@index([severity])
}

model SymbolSourceAsset {
  id        String         @id @default(cuid())
  symbolId  String?
  versionId String?
  symbol    Symbol?        @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  version   SymbolVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  sizeBytes Int
  dataUrl   String?
  createdAt DateTime       @default(now())

  @@index([symbolId])
  @@index([versionId])
}

model SymbolEngineerNote {
  id            String         @id @default(cuid())
  symbolId      String
  versionId     String?
  symbol        Symbol         @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  version       SymbolVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  notes         String
  imageFileName String?
  imageMimeType String?
  imageSizeBytes Int?
  imageDataUrl  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([symbolId])
  @@index([versionId])
  @@index([createdAt])
}

model SymbolDocument {
  id          String         @id @default(cuid())
  symbolId    String
  versionId   String?
  symbol      Symbol         @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  version     SymbolVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  title       String
  fileName    String
  mimeType    String
  sizeBytes   Int
  dataUrl     String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([symbolId])
  @@index([versionId])
  @@index([createdAt])
}

model BomItem {
  id                    String                  @id @default(cuid())
  itemKey               String                  @unique
  displayName           String
  description           String?
  category              String
  unit                  String
  manufacturer          String?
  partNumber            String?
  model                 String?
  notes                 String?
  supplierName          String?
  supplierContactName   String?
  supplierEmail         String?
  supplierPhone         String?
  supplierWebsite       String?
  supplierSku           String?
  unitCost              Float?
  currency              String?
  leadTimeDays          Int?
  minimumOrderQuantity  Float?
  costNotes             String?
  productUrl            String?
  productUrlExtractedAt DateTime?
  status                String                  @default("active")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  images                BomItemImage[]
  documents             BomItemDocument[]
  templateLines         SymbolBomTemplateLine[]

  @@index([status])
  @@index([category])
  @@index([manufacturer])
  @@index([supplierName])
  @@index([status, displayName, itemKey])
  @@index([status, category, displayName, itemKey])
  @@index([status, manufacturer, displayName, itemKey])
}

model BomItemKeySequence {
  scope     String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model BomItemCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model BomItemManufacturer {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model BomItemImage {
  id        String   @id @default(cuid())
  itemId    String
  item      BomItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  sizeBytes Int
  dataUrl   String
  caption   String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
  @@index([itemId, sortOrder])
}

model BomItemDocument {
  id        String   @id @default(cuid())
  itemId    String
  item      BomItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  title     String
  fileName  String
  mimeType  String
  sizeBytes Int
  dataUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
  @@index([itemId, createdAt])
}

model SymbolBomTemplate {
  id        String                  @id @default(cuid())
  symbolId  String                  @unique
  symbol    Symbol                  @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  notes     String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  lines     SymbolBomTemplateLine[]

  @@index([updatedAt])
}

model SymbolBomTemplateLine {
  id           String            @id @default(cuid())
  templateId   String
  template     SymbolBomTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  itemId       String
  item         BomItem           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lineNumber   Int
  quantityRule String
  quantity     Float             @default(1)
  notes        String?

  @@unique([templateId, lineNumber])
  @@index([itemId])
  @@index([quantityRule])
}

model Drawing {
  id               String                   @id @default(cuid())
  drawingKey       String                   @unique
  title            String
  status           String                   @default("draft")
  modelJson        String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  validationIssues DrawingValidationIssue[]

  @@index([status])
  @@index([updatedAt])
}

model DrawingValidationIssue {
  id        String   @id @default(cuid())
  drawingId String
  drawing   Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  severity  String
  code      String
  message   String
  path      String?
  createdAt DateTime @default(now())

  @@index([drawingId])
  @@index([severity])
}
