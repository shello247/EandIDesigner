model StandardReference {
  id String @id
  key String @unique
  title String
  status String @default("active")
  currentRevisionNumber Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions StandardReferenceRevision[]
  @@index([status, title])
}

model StandardReferenceRevision {
  id String @id
  entityId String
  entity StandardReference @relation(fields: [entityId], references: [id], onDelete: Restrict)
  revisionNumber Int
  payloadJson String
  contentHash String
  createdAt DateTime @default(now())
  requirements StandardRequirementRevision[]
  @@unique([entityId, revisionNumber])
}

model StandardRequirement {
  id String @id
  key String @unique
  title String
  status String @default("active")
  currentRevisionNumber Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions StandardRequirementRevision[]
  @@index([status, title])
}

model StandardRequirementRevision {
  id String @id
  entityId String
  entity StandardRequirement @relation(fields: [entityId], references: [id], onDelete: Restrict)
  revisionNumber Int
  payloadJson String
  contentHash String
  createdAt DateTime @default(now())
  sourceRevisionId String
  source StandardReferenceRevision @relation(fields: [sourceRevisionId], references: [id], onDelete: Restrict)
  implementations StandardImplementationRevision[]
  evidence StandardEvidence[]
  entries StandardProfileEntry[]
  @@unique([entityId, revisionNumber])
}

model StandardImplementation {
  id String @id
  key String @unique
  title String
  status String @default("active")
  currentRevisionNumber Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions StandardImplementationRevision[]
  @@index([status, title])
}

model StandardImplementationRevision {
  id String @id
  entityId String
  entity StandardImplementation @relation(fields: [entityId], references: [id], onDelete: Restrict)
  revisionNumber Int
  payloadJson String
  contentHash String
  createdAt DateTime @default(now())
  requirementRevisionId String
  requirement StandardRequirementRevision @relation(fields: [requirementRevisionId], references: [id], onDelete: Restrict)
  evidence StandardEvidence[]
  entries StandardProfileEntry[]
  @@unique([entityId, revisionNumber])
}

model StandardProfile {
  id String @id
  key String @unique
  title String
  status String @default("active")
  currentRevisionNumber Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions StandardProfileRevision[]
  @@index([status, title])
}

model StandardProfileRevision {
  id String @id
  entityId String
  entity StandardProfile @relation(fields: [entityId], references: [id], onDelete: Restrict)
  revisionNumber Int
  payloadJson String
  contentHash String
  createdAt DateTime @default(now())
  entries StandardProfileEntry[]
  snapshots StandardSnapshot[]
  @@unique([entityId, revisionNumber])
}

model StandardProfileEntry {
  profileRevisionId String
  requirementRevisionId String
  implementationRevisionId String?
  applicability String
  rationale String
  conflict String
  profile StandardProfileRevision @relation(fields: [profileRevisionId], references: [id], onDelete: Restrict)
  requirement StandardRequirementRevision @relation(fields: [requirementRevisionId], references: [id], onDelete: Restrict)
  implementation StandardImplementationRevision? @relation(fields: [implementationRevisionId], references: [id], onDelete: Restrict)
  @@id([profileRevisionId, requirementRevisionId])
  @@index([requirementRevisionId])
  @@index([implementationRevisionId])
}

model StandardEvidence {
  id String @id
  requirementRevisionId String
  implementationRevisionId String?
  sourceRevisionId String
  payloadJson String
  contentHash String
  createdAt DateTime @default(now())
  requirement StandardRequirementRevision @relation(fields: [requirementRevisionId], references: [id], onDelete: Restrict)
  implementation StandardImplementationRevision? @relation(fields: [implementationRevisionId], references: [id], onDelete: Restrict)
  @@index([requirementRevisionId, createdAt])
}

model StandardReviewNote {
  id String @id
  targetKind String
  targetRevisionId String
  payloadJson String
  createdAt DateTime @default(now())
  @@index([targetKind, targetRevisionId, createdAt])
}

model StandardSnapshot {
  id String @id
  profileRevisionId String
  payloadJson String
  contentHash String
  createdAt DateTime @default(now())
  profile StandardProfileRevision @relation(fields: [profileRevisionId], references: [id], onDelete: Restrict)
  @@index([profileRevisionId, createdAt])
}

model StandardAuditEvent {
  id String @id
  operationId String @unique
  requestHash String
  kind String
  targetId String
  resultJson String
  createdAt DateTime @default(now())
  @@index([kind, targetId, createdAt])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Symbol {
  id               String                  @id @default(cuid())
  symbolKey        String                  @unique
  displayName      String
  manufacturer     String?
  model            String?
  category         String
  categoryId       String?
  managedCategory  SymbolCategory?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status           String                  @default("draft")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  versions         SymbolVersion[]
  sourceAssets     SymbolSourceAsset[]
  validationIssues SymbolValidationIssue[]


  bomTemplate      SymbolBomTemplate?

  @@index([status])
  @@index([category])
  @@index([categoryId])
}

model SymbolCategory {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  description    String?
  isProtected    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  symbols        Symbol[]

  @@index([name])
}

model WireCatalogEntry {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  wireType       String
  size           String
  color          String
  notes          String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([name])
  @@index([isDefault])
}

model SymbolVersion {
  id                 String                  @id @default(cuid())
  symbolId           String
  symbol             Symbol                  @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  versionNumber      Int
  status             String                  @default("needs_review")
  svg                String
  metadataJson       String
  deviceType         String?
  sourceInputSummary String?
  aiResponseId       String?
  createdAt          DateTime                @default(now())
  sourceAssets       SymbolSourceAsset[]
  validationIssues   SymbolValidationIssue[]


  itemConfigurations SymbolItemConfiguration[]

  @@unique([symbolId, versionNumber])
  @@index([symbolId, status])
  @@index([deviceType])
}

model SymbolValidationIssue {
  id        String         @id @default(cuid())
  symbolId  String
  versionId String?
  symbol    Symbol         @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  version   SymbolVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)
  severity  String
  code      String
  message   String
  path      String?
  createdAt DateTime       @default(now())

  @@index([symbolId])
  @@index([versionId])
  @@index([severity])
}

model SymbolSourceAsset {
  id        String         @id @default(cuid())
  symbolId  String?
  versionId String?
  symbol    Symbol?        @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  version   SymbolVersion? @relation(fields: [versionId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  sizeBytes Int
  dataUrl   String?
  createdAt DateTime       @default(now())

  @@index([symbolId])
  @@index([versionId])
}

model BomItem {
  id                    String                  @id @default(cuid())
  itemKey               String                  @unique
  displayName           String
  description           String?
  category              String
  unit                  String
  manufacturer          String?
  partNumber            String?
  model                 String?
  notes                 String?
  supplierName          String?
  supplierContactName   String?
  supplierEmail         String?
  supplierPhone         String?
  supplierWebsite       String?
  supplierSku           String?
  unitCost              Float?
  currency              String?
  leadTimeDays          Int?
  minimumOrderQuantity  Float?
  costNotes             String?
  productUrl            String?
  productUrlExtractedAt DateTime?
  status                String                  @default("active")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  images                BomItemImage[]
  documents             BomItemDocument[]
  templateLines         SymbolBomTemplateLine[]
  engineeringRevisions  BomItemEngineeringRevision[]
  engineerNotes         BomItemEngineerNote[]

  @@index([status])
  @@index([category])
  @@index([manufacturer])
  @@index([supplierName])
  @@index([status, displayName, itemKey])
  @@index([status, category, displayName, itemKey])
  @@index([status, manufacturer, displayName, itemKey])
}

model BomItemKeySequence {
  scope     String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model BomItemCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model BomItemManufacturer {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model BomItemImage {
  id        String   @id @default(cuid())
  itemId    String
  item      BomItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fileName  String
  mimeType  String
  sizeBytes Int
  dataUrl   String
  caption   String?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([itemId])
  @@index([itemId, sortOrder])
}

model BomItemDocument {
  id        String   @id @default(cuid())
  itemId    String
  item      BomItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  title     String
  fileName  String
  mimeType  String
  sizeBytes Int
  dataUrl   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  archivedAt DateTime?
  contentHash String?
  revisionLinks BomItemRevisionDocument[]

  @@unique([id, itemId])
  @@index([itemId])
  @@index([itemId, createdAt])
}

model EngineeringAttributeType {
  id String @id @default(cuid())
  name String
  normalizedName String @unique
  status String @default("active")
  analysisKey String? @unique
  currentRevision Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revisions EngineeringAttributeTypeRevision[]
  @@index([status, name])
}

model EngineeringAttributeTypeRevision {
  id String @id @default(cuid())
  typeId String
  type EngineeringAttributeType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  revisionNumber Int
  definitionJson String
  contentHash String
  createdAt DateTime @default(now())
  @@unique([typeId, revisionNumber])
}

model BomItemEngineeringRevision {
  id String @id @default(cuid())
  itemId String
  item BomItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  revisionNumber Int
  identityJson String
  profileJson String
  contentHash String
  createdAt DateTime @default(now())
  notes BomItemRevisionNote[]
  documents BomItemRevisionDocument[]
  configurationOptions SymbolItemConfigurationOption[]
  configurationParts SymbolItemConfigurationPart[]

  @@unique([itemId, revisionNumber])
  @@unique([id, itemId])
}

model BomItemEngineerNote {
  id String @id @default(cuid())
  itemId String
  item BomItem @relation(fields: [itemId], references: [id], onDelete: Restrict)
  notes String
  imageFileName String?
  imageMimeType String?
  imageSizeBytes Int?
  imageDataUrl String?
  contentHash String
  supersedesId String?
  createdAt DateTime @default(now())
  archivedAt DateTime?
  libraryPosition Int?
  revisionLinks BomItemRevisionNote[]

  @@unique([id, itemId])
  @@index([itemId, createdAt])
}

model BomItemRevisionNote {
  revisionId String
  itemId String
  noteId String
  revision BomItemEngineeringRevision @relation(fields: [revisionId, itemId], references: [id, itemId], onDelete: Restrict, onUpdate: Restrict)
  note BomItemEngineerNote @relation(fields: [noteId, itemId], references: [id, itemId], onDelete: Restrict, onUpdate: Restrict)

  @@id([revisionId, noteId])
  @@index([noteId, itemId])
}

model BomItemRevisionDocument {
  revisionId String
  itemId String
  documentId String
  revision BomItemEngineeringRevision @relation(fields: [revisionId, itemId], references: [id, itemId], onDelete: Restrict, onUpdate: Restrict)
  document BomItemDocument @relation(fields: [documentId, itemId], references: [id, itemId], onDelete: Restrict, onUpdate: Restrict)

  @@id([revisionId, documentId])
  @@index([documentId, itemId])
}

model SymbolItemConfiguration {
  id String @id @default(cuid())
  symbolVersionId String
  symbolVersion SymbolVersion @relation(fields: [symbolVersionId], references: [id], onDelete: Restrict)
  revisionNumber Int
  symbolContractHash String
  createdAt DateTime @default(now())
  options SymbolItemConfigurationOption[]
  parts SymbolItemConfigurationPart[]

  @@unique([symbolVersionId, revisionNumber])
}

model SymbolItemConfigurationOption {
  id String @id @default(cuid())
  configurationId String
  configuration SymbolItemConfiguration @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  itemEngineeringRevisionId String
  itemEngineeringRevision BomItemEngineeringRevision @relation(fields: [itemEngineeringRevisionId], references: [id], onDelete: Restrict)
  usage String
  evidence String
  interfaceJson String @default("{}")
  parts SymbolItemConfigurationPart[]

  @@unique([configurationId, itemEngineeringRevisionId])
  @@unique([id, configurationId])
  @@index([itemEngineeringRevisionId])
}

model SymbolItemConfigurationPart {
  id String @id @default(cuid())
  configurationId String
  configuration SymbolItemConfiguration @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  optionId String?
  option SymbolItemConfigurationOption? @relation(fields: [optionId, configurationId], references: [id, configurationId], onDelete: Restrict, onUpdate: Restrict)
  itemEngineeringRevisionId String
  itemEngineeringRevision BomItemEngineeringRevision @relation(fields: [itemEngineeringRevisionId], references: [id], onDelete: Restrict)
  lineKey String
  quantityRule String
  quantity Float @default(1)

  @@unique([configurationId, lineKey])
  @@index([optionId, configurationId])
  @@index([itemEngineeringRevisionId])
}

model SymbolBomTemplate {
  id        String                  @id @default(cuid())
  symbolId  String                  @unique
  symbol    Symbol                  @relation(fields: [symbolId], references: [id], onDelete: Cascade)
  notes     String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  lines     SymbolBomTemplateLine[]

  @@index([updatedAt])
}

model SymbolBomTemplateLine {
  id           String            @id @default(cuid())
  templateId   String
  template     SymbolBomTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  itemId       String
  item         BomItem           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  lineNumber   Int
  quantityRule String
  quantity     Float             @default(1)
  notes        String?

  @@unique([templateId, lineNumber])
  @@index([itemId])
  @@index([quantityRule])
}

model Project {
  id                      String    @id @default(cuid())
  name                    String
  projectNumber           String?
  normalizedProjectNumber String?   @unique
  client                  String?
  clientId                String?
  clientRecord            Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  description             String?
  status                  String    @default("active")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  drawings                Drawing[]

  @@index([name])
  @@index([status, updatedAt])
  @@index([clientId])
}

model Client {
  id             String    @id @default(cuid())
  name           String
  normalizedName String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  projects       Project[]

  @@index([name])
}

model ProjectNumberSequence {
  scope     String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Drawing {
  id               String                   @id @default(cuid())
  drawingKey       String                   @unique
  title            String
  description      String?
  projectId        String?
  project          Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status           String                   @default("draft")
  modelJson        String
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  validationIssues DrawingValidationIssue[]

  @@index([status])
  @@index([updatedAt])
  @@index([projectId])
}

model DrawingValidationIssue {
  id        String   @id @default(cuid())
  drawingId String
  drawing   Drawing  @relation(fields: [drawingId], references: [id], onDelete: Cascade)
  severity  String
  code      String
  message   String
  path      String?
  createdAt DateTime @default(now())

  @@index([drawingId])
  @@index([severity])
}
