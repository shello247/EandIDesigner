{
  "name": "ei-designer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "predev": "prisma generate",
    "dev": "tsx scripts/start-development-server.ts --turbopack",
    "dev:webpack": "prisma generate && tsx scripts/start-development-server.ts --webpack",
    "dev:e2e": "tsx scripts/bootstrap-sqlite.ts && next start --hostname 127.0.0.1 --port 3100",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:panel-perf": "tsx scripts/panel-performance.ts",
    "benchmark:bom": "tsx scripts/benchmark-bom-generation.ts",
    "audit:dependencies": "tsx scripts/audit-dependencies.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:setup": "prisma generate && tsx scripts/bootstrap-sqlite.ts",
    "db:retire-sheet-templates": "tsx scripts/retire-drawing-sheet-template-storage.ts",
    "db:seed": "tsx prisma/seed.ts",
    "import:symbols": "tsx scripts/import-existing-symbols.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "exceljs": "^4.4.0",
    "lucide-react": "1.21.0",
    "next": "16.2.11",
    "openai": "6.45.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.11",
    "jsdom": "29.1.1",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
